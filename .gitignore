# Python bytecode
__pycache__/
*.py[cod]

# Virtual environment
.venv/

# Test / coverage / tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Packaging / build
dist/
build/
*.egg-info/

# Runtime artifacts (keep the directory, ignore its contents)
artifacts/*
!artifacts/.gitkeep
# P0 gate report (ACS-P0-008) is committed when status == PASS.
!artifacts/phase0_foundation_gate.json
# A14 renderer spike decision record (ACS-F1-032).
!artifacts/renderer_spike_result.json

# Logs
*.log

# Local environment / secrets
.env
.env.*

# Agent scratch/probe directories (Codex/Claude adversarial gate runs
# create these directly in the main checkout; some nested pytest-cache
# subdirs get Windows ACLs that block deletion from a normal session).
.tmp_*/
.tmp_*
